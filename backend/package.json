{
  "name": "recruitflow-ai-backend",
  "version": "1.0.0",
  "description": "RecruitFlow AI — Multi-Agent HR Resume Ranker powered by OpenAI GPT-4o",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/config/seed.js",
    "test": "node node_modules/cross-env/src/bin/cross-env.js NODE_ENV=test node node_modules/jest/bin/jest.js --testEnvironment=node --forceExit",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mammoth": "^1.6.0",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}